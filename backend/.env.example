PORT=5000
NODE_ENV=development
SESSION_SECRET=change_this_to_a_long_random_secret

# ─── Salesforce OAuth 2.0 ───────────────────────────────────────────────────
# Get these from: Salesforce Setup > App Manager > Your External Client App
SALESFORCE_CLIENT_ID=your_consumer_key_here
SALESFORCE_CLIENT_SECRET=your_consumer_secret_here
SALESFORCE_CALLBACK_URL=http://localhost:5000/api/auth/salesforce/callback
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# ─── Frontend URL ────────────────────────────────────────────────────────────
# The origin of the React frontend (used for CORS and OAuth redirect)
FRONTEND_URL=http://localhost:5173
